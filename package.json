{
  "name": "dsh-qq-whale",
  "version": "0.3.0",
  "description": "养鱼的 QQ 通道：接 OneBot 11（NapCat / LLOneBot），收私信、发消息、戳一戳、扫码登录；别人发来的话先进待审队列，主人点头才回；群聊里主人 @ 她直接回，别人 @ 她先问主人。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "onebot",
    "napcat",
    "agent"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify": "node tests/qr-verify.mjs && node tests/qr-e2e.mjs && node tests/qq-live.mjs && node tests/pending-live.mjs && node tests/group-live.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./onebot": "./lib/onebot.js",
    "./pending": "./lib/pending.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "core",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "dsh-whale-core": ">=0.1.0"
  },
  "license": "MIT",
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
